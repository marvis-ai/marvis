{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marvis",
  "version": "0.1.0",
  "identifier": "com.marvis.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "entitlements": null,
      "infoPlist": "Info.plist"
    }
  }
}
