{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {},
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build:dev": {
      "persistent": true,
      "cache": false
    }
  }
}
